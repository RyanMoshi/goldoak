# Domain Caddy serves (DNS A record must point at this server)
DOMAIN=wa.example.com
# Same values as OPENWA_API_KEY / OPENWA_SESSION_ID on Vercel
OPENWA_API_KEY=change-me-long-random
OPENWA_SESSION_ID=goldoak
# Super Agent webhook (the app verifies X-OpenWA-Signature with OPENWA_WEBHOOK_SECRET)
WEBHOOK_URL=https://goldoak.vercel.app/api/whatsapp/openwa
