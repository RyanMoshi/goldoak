# --- Site: email sending (contact and risk-review forms) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
TO_EMAIL=info@goldoak.co.ke
NEXT_PUBLIC_SITE_URL=http://localhost:3000
UPLOAD_DIR=public/uploads

# --- Platform: database (Supabase Postgres via the Supabase Vercel integration) ---
# The integration syncs POSTGRES_URL (pooled) and friends to Vercel Production.
# Locally: `vercel env pull .env.local --environment=production`. DATABASE_URL also works.
POSTGRES_URL=

# --- Platform: sessions ---
# Any random string of 32+ characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# --- Platform: WhatsApp Cloud API (Meta) ---
# From developers.facebook.com → your app → WhatsApp → API Setup.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any string you choose; paste the same value in the Meta webhook configuration.
WHATSAPP_VERIFY_TOKEN=
# App Secret from the app's Basic Settings; used to verify webhook signatures.
WHATSAPP_APP_SECRET=
