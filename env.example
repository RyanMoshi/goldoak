# --- Site: email sending (contact and risk-review forms) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
TO_EMAIL=info@goldoak.co.ke
NEXT_PUBLIC_SITE_URL=https://goldoak.vercel.app
UPLOAD_DIR=public/uploads

# --- Platform: database (Supabase Postgres via the Supabase Vercel integration) ---
# The integration syncs POSTGRES_URL (pooled) to Vercel Production as a sensitive value.
# Locally you can set DATABASE_URL to the pooled Supabase URL instead.
POSTGRES_URL=

# --- Platform: sessions and admin ---
# AUTH_SECRET: any random string of 32+ characters.
AUTH_SECRET=
# ADMIN_TOKEN: random 32+ chars. Lets `npm run db:seed` call /api/admin/seed inside the deployment.
ADMIN_TOKEN=
# The platform admin created by the bootstrap (first run only).
ADMIN_EMAIL=admin@goldoak.co.ke
ADMIN_PASSWORD=
# CRON_SECRET: Vercel sends it as a Bearer token to /api/cron/daily.
CRON_SECRET=
# Organisation new sign-ups join.
DEFAULT_ORGANIZATION_ID=org_goldoak

# --- Platform: WhatsApp ---
# The number clients message (E.164 digits, no plus).
WHATSAPP_BOT_NUMBER=255742473493

# Option A (preferred): OpenWA self-hosted gateway - https://github.com/rmyndharis/OpenWA
OPENWA_BASE_URL=https://your-openwa-host:2785
OPENWA_API_KEY=
OPENWA_SESSION_ID=goldoak
# Secret you set when registering the webhook on the session; verifies X-OpenWA-Signature.
OPENWA_WEBHOOK_SECRET=

# Option B: Meta WhatsApp Cloud API (used only when OPENWA_* is not set)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
